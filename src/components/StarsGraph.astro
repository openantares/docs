---
// The brand stars-graph illustration, inlined per theme so its labels can
// fall back to the page's fonts. Decorative — hidden from assistive tech.
import darkArt from '../assets/illustrations/stars-graph-white-transparent.svg?raw';
import lightArt from '../assets/illustrations/stars-graph-black-transparent.svg?raw';
---

<div class="hero-illustration" aria-hidden="true">
	<div class="dark:sl-hidden" set:html={lightArt} />
	<div class="light:sl-hidden" set:html={darkArt} />
</div>
